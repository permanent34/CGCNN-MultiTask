# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover
.hypothesis/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# IPython Notebook
.ipynb_checkpoints

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# dotenv
.env

# virtualenv
venv/
ENV/

# Spyder project settings
.spyderproject

# Rope project settings
.ropeproject

# User directories
Local

# .DS_Store
.DS_Store

# IDE and local editor state
.idea/
.vscode/

# Project data and training artifacts
# Keep small reproducible examples; ignore large or regenerated datasets.
data/material-data/
data/mt-large/
data/mt-run/
data/shc/
data/shc-log/
data/shc-max-log/

# Outputs written to the repository root by main.py/predict.py.
/checkpoint.pth.tar
/model_best.pth.tar
/test_results.csv

# Archives and downloaded/generated model weights.
*.zip
*.tar
*.tar.gz
*.ckpt
*.pt
*.onnx

# User-generated checkpoints are ignored, but the published pre-trained
# models in pre-trained/ are small enough to include in the repository.
*.pth.tar
!pre-trained/*.pth.tar

# Keep experiment logs that are explicitly saved under results/.
!results/**/*.log

# Local derived MP single-task view and graph cache. These can be regenerated
# from data/mt-large, so they are intentionally not committed.
data/mp-single-formation/
data/**/.cgcnn_cache/

# Private presentation build output and local builder.
presentation/.build_mp_20260917/
presentation/build_mp_deck.mjs
